{
  "name": "pi-memory-orchestrator",
  "version": "1.1.4",
  "description": "Shared scoped memory orchestration for Pi and OMP with local Hindsight.",
  "type": "module",
  "main": "src/index.ts",
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "node --import tsx --test tests/**/*.test.ts",
    "sidecar": "sh scripts/start-sidecar.sh",
    "benchmark": "node scripts/benchmark-recall.mjs"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "memory",
    "hindsight",
    "omp"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.80.6"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.80.6",
    "@types/node": "^24.0.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.0"
  },
  "dependencies": {
    "typebox": "^1.3.30"
  }
}

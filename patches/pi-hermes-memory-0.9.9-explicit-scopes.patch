+const EXTERNAL_PROJECT_RESOLVER_EVENT = "pi-hermes-memory:resolve-project";
+
+type ExternalProjectResolutionRequest = {
+  ctx: ExtensionContext;
+  respond: (result: ProjectInfo | null | Promise<ProjectInfo | null>) => void;
+};
+
+async function resolveExternalProject(
+  pi: ExtensionAPI,
+  ctx: ExtensionContext,
+): Promise<ProjectInfo> {
+  const responses: Array<Promise<ProjectInfo | null>> = [];
+  const request: ExternalProjectResolutionRequest = {
+    ctx,
+    respond(result) {
+      responses.push(Promise.resolve(result));
+    },
+  };
+  pi.events.emit(EXTERNAL_PROJECT_RESOLVER_EVENT, request);
+  if (!responses.length) return { name: null, memoryDir: null };
+  return (await responses[0]) ?? { name: null, memoryDir: null };
